# Copy to .env and fill in real values. Never commit .env.
PORT=3000
NODE_ENV=development

# Required: long random string for signing auth cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<redacted>

# --- Database ---
# Local dev: leave DATABASE_URL empty to use the SQLite file below.
# Production (Render free tier): set DATABASE_URL to your Neon Postgres
# connection string. The app switches to Postgres automatically and enables
# SSL as Neon requires. Never commit the real URL.
DATABASE_URL=

# SQLite database file path (used only when DATABASE_URL is empty)
DB_PATH=./data/store.db

# Google OAuth (optional). Get a Client ID from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID, type "Web application").
# Add your site origin (e.g. https://your-domain.com) to Authorized JavaScript origins.
# Leave blank to disable Google login (UI shows a friendly notice instead).
GOOGLE_CLIENT_ID=

# XtraGateway online payments (https://paysafe.mlbbstore.in).
# XTRA_USER_TOKEN is your merchant token from XtraGateway. Leave blank to
# disable the "Pay online" button (manual UPI flow stays available).
# PUBLIC_BASE_URL must be this store's public URL: the gateway redirects
# customers back to PUBLIC_BASE_URL/payment-return.html after payment.
XTRA_USER_TOKEN=
XTRA_BASE_URL=https://paysafe.mlbbstore.in
PUBLIC_BASE_URL=http://localhost:3000

# Topzy auto-fulfilment (MLBB top-ups, https://topzy.in).
# TOPZY_API_KEY is your Topzy partner API key. Leave blank to disable
# auto-fulfilment (orders are then fulfilled manually as before).
# On Render: add it under Environment, never commit the real key.
TOPZY_API_KEY=
